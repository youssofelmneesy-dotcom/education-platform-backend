NODE_ENV=test
PORT=4001

# Dedicated test database (Postgres)
# Adjust host/port/user/password/dbname as needed or run docker-compose.test.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/teching_test?schema=public

# JWT settings
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_EXPIRES_IN=1h

# Rate limiting - keep defaults but can be tuned for tests
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

REQUEST_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
