{
  "name": "back-end",
  "version": "1.0.0",
  "description": "Production-ready backend for the Education Platform.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc -p tsconfig.build.json --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:unit": "NODE_ENV=test vitest run --config vitest.unit.config.ts",
    "test:smoke": "NODE_ENV=test vitest run --config vitest.smoke.config.ts",
    "test:integration": "NODE_ENV=test vitest run --config vitest.integration.config.ts",
    "test:api": "node ./scripts/run-api-tests.mjs cli",
    "test:api:html": "node ./scripts/run-api-tests.mjs html",
    "test:performance": "node ./scripts/run-performance-tests.mjs",
    "coverage": "NODE_ENV=test vitest run --config vitest.coverage.config.ts --coverage",
    "test:all": "npm run test:unit && npm run test:smoke && npm run test:integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prepare": "prisma generate"
  },
  "keywords": [
    "education",
    "backend",
    "express",
    "typescript"
  ],
  "author": "Yousef Elfaidy",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "prisma": "^6.15.0",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10"
  }
}
