  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  certificates Certificate[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([isDefault])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("certificate_templates")
}

model CertificateVerification {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  certificateId String      @unique @db.Uuid
  verificationCode String   @unique @db.VarChar(100)
  verifiedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  certificate   Certificate @relation(fields: [tenantId, certificateId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, certificateId])
  @@index([tenantId])
  @@index([verifiedAt])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("certificate_verifications")
}
