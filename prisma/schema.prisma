// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  firstName    String     @db.VarChar(50)
  lastName     String     @db.VarChar(50)
  email        String     @db.VarChar(255)
  passwordHash String
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profile      Profile?
  roles        UserRole[]
  refreshTokens RefreshToken[]
  otps         OTP[]
  sessions     UserSession[]
  trustedDevices TrustedDevice[]
  loginHistory LoginHistory[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("users")
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(100)
  slug        String       @unique @db.VarChar(100)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  users       User[]
  profiles    Profile[]
  roles       Role[]
  permissions Permission[]
  userRoles   UserRole[]
  rolePermissions RolePermission[]
  refreshTokens RefreshToken[]
  otps        OTP[]
  sessions    UserSession[]
  trustedDevices TrustedDevice[]
  loginHistory LoginHistory[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("tenants")
}

model Profile {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @unique @db.Uuid
  phone     String?   @db.VarChar(30)
  avatarUrl String?   @db.VarChar(500)
  bio       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("profiles")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String           @db.VarChar(100)
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  resource    String           @db.VarChar(100)
  action      String           @db.VarChar(100)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roles       RolePermission[]

  @@unique([tenantId, resource, action])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("permissions")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  role      Role      @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, userId, roleId])
  @@index([tenantId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId, deletedAt])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role         Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [tenantId, permissionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
  @@index([roleId])
  @@index([permissionId])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("role_permissions")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([tenantId, userId])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("refresh_tokens")
}

model OTP {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  purpose   String    @db.VarChar(50)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
  @@index([tenantId, userId, purpose])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("otps")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  sessionHash String  @unique
  ipAddress String?   @db.VarChar(45)
  userAgent String?
  startedAt DateTime  @default(now())
  lastSeenAt DateTime?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([tenantId, userId])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("user_sessions")
}

model TrustedDevice {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  userId                String    @db.Uuid
  deviceFingerprintHash String
  deviceName            String?   @db.VarChar(100)
  ipAddress             String?   @db.VarChar(45)
  userAgent             String?
  trustedAt             DateTime  @default(now())
  lastUsedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                  User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, userId, deviceFingerprintHash])
  @@index([tenantId])
  @@index([userId])
  @@index([revokedAt])
  @@index([tenantId, userId])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("trusted_devices")
}

model LoginHistory {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  userId     String?   @db.Uuid
  email      String    @db.VarChar(255)
  successful Boolean   @default(false)
  failureReason String? @db.VarChar(255)
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User?     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([email])
  @@index([successful])
  @@index([createdAt])
  @@index([tenantId, email])
  @@index([tenantId, userId])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("login_history")
}
